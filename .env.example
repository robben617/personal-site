# 复制成 .env.local 后填写。.env.local 已被 .gitignore 忽略，不会提交。
# 真实密钥只放在本地和部署平台的环境变量里，永远不要写进代码或提交。

DEEPSEEK_API_KEY=

# 可选：默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# 可选：部署后改成线上域名，用于 canonical 与 Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 网站上展示的联系邮箱。刻意不写进 data/profile.json，
# 避免公开仓库里出现明文邮箱；留空则页面不显示邮箱入口。
CONTACT_EMAIL=
